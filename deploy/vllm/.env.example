# ==== PGuard vLLM guard service configuration ====

# Backbone weights (Qwen3.5-9B FP8-dynamic recommended for 24G GPUs)
HOST_BACKBONE_DIR=/path/to/Qwen3.5-9B-FP8-dynamic

# Physical GPU index
PGUARD_GPU=0

# Service port (host)
PGUARD_PORT=13553

# Safety head checkpoint dir name(s) under ./pguard_heads
# single head: PGUARD_HEAD_SUBDIR=PGuard-EMA-Qwen3.5-9B
# multi-head:  PGUARD_HEADS=PGuard-Lasttok-Qwen3.5-9B,PGuard-EMA-Qwen3.5-9B,PGuard-GRU-Qwen3.5-9B
PGUARD_HEAD_SUBDIR=PGuard-EMA-Qwen3.5-9B
PGUARD_HEADS=

# Risk threshold (max non-normal class probability)
PGUARD_THRESHOLD=0.5

# Execution mode: 0 = CUDA graphs (recommended, needs aux + V2 runner), 1 = eager
PGUARD_ENFORCE_EAGER=0
PGUARD_CAPTURE_MODE=aux
VLLM_USE_V2_MODEL_RUNNER=1

# Scoring cadence: 1.0 = every output token; 0.1 = every 10th
# (the prompt side always scores; recurrent state updates every step)
PGUARD_COPY_LOGITS_PROB=1.0
# Direct scoring interval in steps (overrides the ratio); leave empty
PGUARD_SCORE_INTERVAL=

# Context length / memory / concurrency
MAX_MODEL_LEN=8192
GPU_MEM_UTIL=0.90
